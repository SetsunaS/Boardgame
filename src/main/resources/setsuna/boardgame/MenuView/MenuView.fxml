<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>

<?import javafx.geometry.Insets?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.3"
           fx:controller="setsuna.boardgame.controller.MenuController"
           fx:id="rootPane"
           stylesheets="@MenuViewStyle.css">

    <FlowPane fx:id="gameSelectionPane" styleClass="gameSelectionPane">
        <Button fx:id="ticTacToeButton" onAction="#clickOnTicTacToeButton" styleClass="gameButton" text="Tic Tac Toe"/>
        <Button fx:id="testButton" onAction="#clickOnTestButton" styleClass="gameButton" text="Test"/>
    </FlowPane>

    <Region fx:id="blurOverlay" styleClass="blurOverlay" visible="false" managed="false"/>

    <VBox fx:id="gameConfigurationPane" styleClass="gameConfigurationPane" visible="false" managed="false">
        <GridPane styleClass="gridPaneOutside">
            <TextField fx:id="gameSizeField" promptText="Game size" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <GridPane styleClass="gridPaneInside" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Button fx:id="playWithAIButton" onAction="#playWithAIButton" styleClass="createGameButton" text="Play VS AI" GridPane.rowIndex="0"/>
                <Button fx:id="createRoomButton" onAction="#createRoom" styleClass="createGameButton" text="Create room" GridPane.rowIndex="1"/>
            </GridPane>

            <TextField fx:id="gameNumberField" promptText="Game number" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Button fx:id="joinRoomButton" onAction="#joinRoom" styleClass="createGameButton" text="Join room" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>

        <Button fx:id="cancelButton" onAction="#hideGameConfiguration" styleClass="cancelButton" text="Cancel">
            <VBox.margin>
                <Insets top="35.0"/>
            </VBox.margin>
        </Button>
    </VBox>

</StackPane>