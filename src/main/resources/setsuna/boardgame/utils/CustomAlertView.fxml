<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.3"
      fx:controller="setsuna.boardgame.utils.CustomAlert"
      styleClass="customAlertPane"
      alignment="CENTER" spacing="20.0"
      stylesheets="@CustomAlertViewStyle.css">

    <padding>
        <Insets bottom="40.0" left="80.0" right="80.0" top="40.0"/>
    </padding>

    <Label fx:id="contentText" styleClass="alertText"/>

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="yesButton" text="Yes" onAction="#clickOnYes" styleClass="alertButton"/>
        <Button fx:id="noButton" text="No" onAction="#clickOnNo" styleClass="alertButton"/>
    </HBox>

</VBox>
