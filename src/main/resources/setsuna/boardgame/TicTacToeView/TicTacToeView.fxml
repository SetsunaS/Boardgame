<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.3"
           fx:controller="setsuna.boardgame.controller.TicTacToeController"
           fx:id="rootPane" styleClass="rootPane"
           stylesheets="@TicTacToeViewStyle.css">

    <GridPane fx:id="ticTacToeGridPane" styleClass="ticTacToeGridPane">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" percentWidth="33.33"/>
            <ColumnConstraints hgrow="NEVER" percentWidth="33.33"/>
            <ColumnConstraints hgrow="NEVER" percentWidth="33.33"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints vgrow="NEVER" percentHeight="33.33"/>
            <RowConstraints vgrow="NEVER" percentHeight="33.33"/>
            <RowConstraints vgrow="NEVER" percentHeight="33.33"/>
        </rowConstraints>

        <Button fx:id="button00" styleClass="game-button" onAction="#onGridButtonClick" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Button fx:id="button10" styleClass="game-button" onAction="#onGridButtonClick" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Button fx:id="button20" styleClass="game-button" onAction="#onGridButtonClick" GridPane.rowIndex="2" GridPane.columnIndex="0"/>

        <Button fx:id="button01" styleClass="game-button" onAction="#onGridButtonClick" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button fx:id="button11" styleClass="game-button" onAction="#onGridButtonClick" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button fx:id="button21" styleClass="game-button" onAction="#onGridButtonClick" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Button fx:id="button02" styleClass="game-button" onAction="#onGridButtonClick" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Button fx:id="button12" styleClass="game-button" onAction="#onGridButtonClick" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <Button fx:id="button22" styleClass="game-button" onAction="#onGridButtonClick" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
    </GridPane>

    <Region fx:id="blurOverlay" styleClass="blurOverlay" visible="false" managed="false"/>

    <VBox fx:id="gameWinnerAnnounce" styleClass="gameWinnerAnnounce" visible="false" managed="false">
        <Label fx:id="gameWinner"/>
    </VBox>

</StackPane>
